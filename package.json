{
  "name": "ats-resume-analyzer",
  "version": "1.0.0",
  "description": "AI-powered ATS resume analyzer that runs entirely in the browser",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "BROWSER=none vite",
    "build": "vite build",
    "build:offline": "vite build --mode production",
    "preview": "vite preview",
    "serve": "vite preview --port 3000",
    "analyze": "npm run build && npx vite-bundle-analyzer",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "download-models": "node scripts/download-models.js",
    "setup:local": "npm run download-models"
  },
  "keywords": [
    "ats",
    "resume",
    "analyzer",
    "ai",
    "privacy"
  ],
  "author": "Suryansh Gupta",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-comlink": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.3",
    "comlink": "^4.4.2",
    "compromise": "^14.14.4",
    "email-regex": "^6.1.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdfjs-dist": "^5.7.284"
  },
  "overrides": {
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  }
}
