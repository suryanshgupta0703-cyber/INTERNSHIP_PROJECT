# Environment Configuration Example
#
# FOR LOCAL DEVELOPMENT:
#   1. Copy this file: cp .env.example .env.development
#   2. Run: npm run download-models
#   3. Keep all values as-is below
#
# FOR PRODUCTION (Cloudflare R2 with HuggingFace-style structure):
#   1. Copy this file: cp .env.example .env.production
#   2. Change VITE_MODEL_SOURCE to 'remote'
#   3. Set VITE_MODEL_BASE_URL to your R2 bucket URL
#   4. Set model paths to just the model names
#
# R2 STRUCTURE REQUIRED:
#   models.your-domain.com/ats-semantic-v1-en/resolve/main/config.json
#   models.your-domain.com/ats-semantic-v1-en/resolve/main/tokenizer.json
#   etc.

# Model source: 'local' for development, 'remote' for production
VITE_MODEL_SOURCE=local

# Base URL for models
# Development: /models (served from public directory)
# Production: https://models.your-domain.com (R2 CDN)
VITE_MODEL_BASE_URL=/models

# Model names (transformers.js will construct full URLs)
VITE_SEMANTIC_MODEL_PATH=ats-semantic-v1-en
VITE_DOMAIN_MODEL_PATH=ats-domain-v1-en

# Feature flags
VITE_DEBUG_MODE=true
VITE_ENABLE_CACHE=true
