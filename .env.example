# Environment Configuration Example
#
# FOR LOCAL DEVELOPMENT:
#   1. Copy this file: cp .env.example .env.development
#   2. Keep VITE_MODEL_SOURCE=remote to use HuggingFace models directly
#   3. No model download required - models are loaded from HuggingFace CDN
#
# FOR PRODUCTION (Cloudflare Workers):
#   1. Copy this file: cp .env.example .env.production
#   2. Keep VITE_MODEL_SOURCE=remote
#   3. Do not set VITE_MODEL_BASE_URL to huggingface.co — the Worker
#      serves models from same-origin /models-proxy to avoid CORS blocks

# Model source: 'remote' uses HuggingFace CDN (recommended), 'local' requires downloaded models
VITE_MODEL_SOURCE=remote

# Base URL for models (only used when VITE_MODEL_SOURCE=local)
# For remote mode, this is ignored and HuggingFace is used directly
VITE_MODEL_BASE_URL=/models

# Model names - using standard HuggingFace models
# Xenova/all-MiniLM-L6-v2 is a lightweight, fast sentence transformer
VITE_SEMANTIC_MODEL_PATH=Xenova/all-MiniLM-L6-v2
VITE_DOMAIN_MODEL_PATH=Xenova/all-MiniLM-L6-v2

# Feature flags
VITE_DEBUG_MODE=true
VITE_ENABLE_CACHE=true
